# AI-AGENT Backend — copy to .env and adjust as needed
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ── Application ──────────────────────────────────────────────
APP_NAME=AI-AGENT
APP_VERSION=0.1.0
DEBUG=false
SQL_ECHO=false
SECRET_KEY=changeme-in-production-32chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database (default: local SQLite, no extra setup) ───────
DATABASE_URL=sqlite+aiosqlite:///./aiagnet.db

# ── Redis (optional — leave empty to disable) ──────────────
REDIS_URL=

# ── Vector store ─────────────────────────────────────────────
# VECTOR_STORE_TYPE: chroma (local) | milvus (remote)
VECTOR_STORE_TYPE=chroma

# ChromaDB — local embedded mode (default)
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_LOCAL_PATH=./chroma_data

# Milvus — only needed when VECTOR_STORE_TYPE=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB=default

# ── File storage ─────────────────────────────────────────────
# MinIO — leave MINIO_ENDPOINT empty to use local filesystem
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false
LOCAL_UPLOADS_DIR=./uploads

# ── LLM providers ────────────────────────────────────────────
# Local Ollama (recommended for dev)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3.6:35b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Cloud APIs (optional — set key to enable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── CORS (JSON array) ───────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]
