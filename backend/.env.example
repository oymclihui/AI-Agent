# AI-AGENT Backend — copy to .env and adjust as needed
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ── Application ──────────────────────────────────────────────
APP_NAME=AI-AGENT
APP_VERSION=0.1.0
DEBUG=false
SQL_ECHO=false
SECRET_KEY=changeme-in-production-32chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Auth & retention ───────────────────────────────────────
# JWT signing key — MUST change in production (≥32 chars)
# Default admin is created on first startup if no users exist
DEFAULT_ADMIN_EMPLOYEE_NO=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@local
# Auto-delete conversations older than N days (list + scheduler)
CONVERSATION_RETENTION_DAYS=30

# Employee templates: categories visible to non-admin users (comma-separated)
# Admin always sees all templates; draft templates are admin-only
EMPLOYEE_TEMPLATE_USER_CATEGORIES=finance

# ── Database ───────────────────────────────────────────────
# Default: local SQLite (zero setup)
# DATABASE_URL=sqlite+aiosqlite:///./aiagnet.db

# DB_DRIVER: auto | sqlite | postgresql | vastbase
# When DB_HOST is set, auto → postgresql unless you set vastbase
# DB_DRIVER=auto

# ── PostgreSQL (remote) ──────────────────────────────────
# Option A: full async URL
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
#
# Option B: compose URL from parts (password special chars auto-encoded)
# DB_DRIVER=postgresql
# DB_HOST=your.remote.server
# DB_PORT=5432
# DB_USER=aiagnet
# DB_PASSWORD=your_password
# DB_NAME=aiagnet
# DB_SSL=prefer
# DB_SSL: disable | prefer | require

# ── VastBase 海量数据库 (PostgreSQL-compatible) ───────────
# Same connection shape as PostgreSQL; set DB_DRIVER=vastbase so /health shows it.
# DB_DRIVER=vastbase
# DB_HOST=vastbase.company.internal
# DB_PORT=5432
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=aiagnet
# DB_SSL=prefer
# DB_SCHEMA=public

# Copy / migrate PostgreSQL → VastBase (duplicate; source PG unchanged):
#   Set SOURCE_DB_* = current PG, TARGET_DB_* = VastBase in .env
#   python scripts/migrate_to_vastbase.py --source postgres --dry-run
#   python scripts/migrate_to_vastbase.py --source postgres
#   From local SQLite: python scripts/migrate_to_vastbase.py
#   See backend/.env.vastbase.example
# Home/dev can keep DB_DRIVER=postgresql; office may optionally use DB_DRIVER=vastbase.

# ── Redis (optional — leave empty to disable) ──────────────
REDIS_URL=

# ── Vector store ─────────────────────────────────────────────
# VECTOR_STORE_TYPE: chroma (local) | milvus (remote)
VECTOR_STORE_TYPE=chroma

# ChromaDB — local embedded mode (default)
CHROMA_MODE=local
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_LOCAL_PATH=./chroma_data

# Milvus — only needed when VECTOR_STORE_TYPE=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB=default

# ── File storage ─────────────────────────────────────────────
# MinIO — leave MINIO_ENDPOINT empty to use local filesystem
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTS=documents
MINIO_SECURE=false
LOCAL_UPLOADS_DIR=./uploads

# ── LLM providers ────────────────────────────────────────────
# Local Ollama (recommended for dev)
OLLAMA_BASE_URL=http://localhost:11434
# Voice input (speech-to-text) — run: ollama pull whisper
STT_MODEL=whisper
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=qwen3.6:35b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Cloud APIs (optional — set key to enable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# BYD EIS internal LLM gateway (OpenAI-compatible; keys auto-seed Model Hub on startup)
BYD_DEEPSEEK_V4_FLASH_API_KEY=
BYD_DEEPSEEK_V4_FLASH_BASE_URL=https://eisapi.byd.com/open-api/1.0/llm/v1/deepseek-v4-flash
BYD_QWEN35_35B_API_KEY=
BYD_QWEN35_35B_BASE_URL=https://eisapi.byd.com/open-api/1.0/llm/v1/qwen35-35b-a3b-fp8
BYD_DEEPSEEK_REASONER_API_KEY=
BYD_DEEPSEEK_REASONER_BASE_URL=https://eisapi.byd.com/open-api/1.0/llm/v1/ds-open-671b
BYD_DEEPSEEK_32B_API_KEY=
BYD_DEEPSEEK_32B_BASE_URL=https://eisapi.byd.com/open-api/1.0/llm/v1/deepseek/stream
# When BYD keys are set, recommended defaults:
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_LLM_MODEL=byd-deepseek-v4-flash

# BYD corporate KMS RAG (unit knowledge base connector)
BYD_KMS_DEFAULT_URL=https://kms-api.byd.com/open-api/1.0/llm/v1/rag-qa
BYD_KMS_API_KEY=
BYD_KMS_TIMEOUT_SECONDS=30

# ── Desktop automation (OpenAdapt sidecar) ───────────────────
# Require human approval before replay (agent/chat/workflow); UI clicks pass confirmed=true
DESKTOP_REQUIRE_CONFIRMATION=true
# Local OpenAdapt data directory (used by sidecar on Windows PC)
DESKTOP_OPENADAPT_DATA_DIR=./desktop_openadapt_data

# ── Agent harness (tool policy & boundaries) ─────────────────
HARNESS_REQUIRE_TOOL_CONFIRMATION=true
HARNESS_LLM_TIMEOUT_SEC=120
HARNESS_MAX_ITERATIONS_CAP=25

# ── CORS (JSON array) ───────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# ── Public URL & password reset ───────────────────────────────
APP_PUBLIC_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60

# ── Platform SMTP (password-reset emails) ─────────────────────
SMTP_HOST=smtp.byd.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=your-mailbox@byd.com
SMTP_PASSWORD=
SMTP_FROM=your-mailbox@byd.com
SMTP_FROM_NAME=AI-AGENT

# ── Default IMAP (user mailbox fetch_mail tool) ───────────────
IMAP_HOST=imap.byd.com
IMAP_PORT=1993
IMAP_USE_SSL=true
