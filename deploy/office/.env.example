# 单位 Ubuntu 部署环境变量 — 复制为 .env 后修改
# cp .env.example .env

HTTP_PORT=3000
SECRET_KEY=change-me-to-random-32chars-min!!

# 应用访问地址（改为服务器实际 IP/域名）
APP_PUBLIC_URL=http://10.138.98.78:3000
ALLOWED_ORIGINS=["http://10.138.98.78:3000","http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_WS_URL=ws://10.138.98.78:3000/ws

# VastBase（PostgreSQL 兼容）
DB_DRIVER=vastbase
DB_HOST=10.9.240.114
DB_PORT=5432
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=fian
DB_SCHEMA=aiagent
DB_SSL=prefer

# Redis（消息/任务；密码含 % 须 URL 编码为 %25）
REDIS_URL=redis://:your_redis_password@10.138.133.102:6479/0

# 首次建库令牌（install.sh 自动生成；管理员访问 /setup?token=...）
SETUP_TOKEN=

DEFAULT_ADMIN_EMPLOYEE_NO=admin
DEFAULT_ADMIN_PASSWORD=admin123

VECTOR_STORE_TYPE=chroma
WEB_SEARCH_PROVIDERS=bing_cn,baidu
WEB_SEARCH_TIMEOUT=10

# LLM — 按单位环境填写（Ollama / BYD EIS 等）
OLLAMA_BASE_URL=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

BYD_DEEPSEEK_V4_FLASH_API_KEY=
BYD_QWEN35_35B_API_KEY=
