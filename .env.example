# ============================================================
# AIAGNET Platform - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# PostgreSQL
POSTGRES_DB=aiagnet
POSTGRES_USER=aiagnet
POSTGRES_PASSWORD=aiagnet123

# Redis
REDIS_PASSWORD=redis123

# MinIO (S3-compatible file storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Application Secret (must be at least 32 chars in production)
SECRET_KEY=changeme-in-production-32chars!!

# LLM API Keys (fill in as needed)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local LLM server, default points to host machine)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
